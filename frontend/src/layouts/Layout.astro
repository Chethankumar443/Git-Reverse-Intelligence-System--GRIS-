---
import '../styles/globals.css';

interface Props {
  title?: string;
}

const { title = "Git Reverse V2.0 — Repository Intelligence & System Prompt Recreation Engine" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Git Reverse V2.0 is an AI repository intelligence system that analyzes target codebases into standardized system recreation prompts, dependency graphs, and AST schemas." />
    
    <!-- Modern Typography Fonts: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#09090b] text-[#fafafa] min-h-screen antialiased selection:bg-[#007cf0] selection:text-white">
    <slot />
  </body>
</html>
