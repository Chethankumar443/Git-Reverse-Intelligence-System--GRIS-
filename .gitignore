# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ── Virtual Environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── uv ────────────────────────────────────────────────────────────────────────
# uv.lock IS committed (reproducible installs)
# Nothing extra to exclude

# ── Environment & Secrets ─────────────────────────────────────────────────────
# NEVER commit real secrets
.env
!.env.example

# ── Git Reverse Runtime Data ──────────────────────────────────────────────────
# These are generated at runtime and must stay local
*.db
*.db-wal
*.db-shm

# ── IDE & OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── PyInstaller / Nuitka Binaries ────────────────────────────────────────────
*.spec
/dist-bin/
