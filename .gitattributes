# Normalise line endings to LF in the repository; let Git handle checkout conversion
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.json text eol=lf

# Treat lock files as binary to avoid diff noise
uv.lock binary
