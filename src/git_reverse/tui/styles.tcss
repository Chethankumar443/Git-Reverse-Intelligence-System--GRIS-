/* Git Reverse Premium TCSS Stylesheet */

/* Color Theme overrides for a high-end Midnight Tech aesthetic */
$primary: #10b981;          /* Emerald Green */
$primary-darken-1: #059669;
$primary-darken-2: #047857;
$primary-darken-3: #065f46;

$accent: #06b6d4;           /* Tech Cyan */
$accent-lighten-1: #22d3ee;
$accent-darken-1: #0891b2;

$surface: #0f172a;          /* Slate Dark Background */
$surface-darken-1: #090d16;
$surface-darken-2: #05080e;

$text: #f8fafc;
$text-muted: #64748b;
$error: #ef4444;
$success: #10b981;
$warning: #f59e0b;

Screen {
    background: $surface;
}

#body {
    height: 1fr;
}

/* Sidebar styling */
#sidebar {
    width: 32;
    min-width: 26;
    border-right: solid $primary-darken-3;
    padding: 1 1;
    background: $surface-darken-1;
    overflow-y: auto;
}

#sidebar.collapsed {
    display: none;
}

#sidebar-title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 0;
    border-bottom: solid $primary-darken-3;
    margin-bottom: 2;
    text-align: center;
}

#session-list-title {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 1;
    padding-left: 1;
}

.session-item {
    padding: 0 1;
    margin-bottom: 1;
}

ListView {
    background: transparent;
}

ListView > ListItem {
    padding: 0;
    margin-bottom: 1;
    background: transparent;
}

ListView > ListItem.--highlight {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

ListView > ListItem:hover {
    background: $primary-darken-3;
}

/* Main panel styling */
#main-panel {
    padding: 1 3;
    background: $surface-darken-2;
    overflow-y: auto;
}

#welcome-content {
    width: 100%;
    height: auto;
}

/* Bento Welcome Dashboard */
#dashboard-logo {
    color: $accent;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

#dashboard-tagline {
    color: $text-muted;
    margin-bottom: 3;
}

#dashboard-zones {
    height: auto;
    margin-bottom: 2;
}

#left-zone {
    width: 58%;
    border: round $primary-darken-2;
    background: $surface-darken-1;
    padding: 1 2;
    margin-right: 2;
    height: auto;
}

#right-zone {
    width: 42%;
    border: round $primary-darken-2;
    background: $surface-darken-1;
    padding: 1 2;
    height: auto;
}

.zone-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

#shortcuts-title {
    margin-top: 2;
}

.zone-desc {
    color: $text-muted;
    margin-bottom: 2;
}

.status-item {
    color: $text;
    margin-bottom: 1;
}

.shortcut-item {
    color: $text-muted;
    margin-bottom: 1;
}

/* Input Fields */
Input {
    border: round $primary-darken-2;
    background: $surface-darken-2;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
}

Input:focus {
    border: round $accent;
}

/* Status Bar */
#status-bar {
    height: 1;
    background: $primary-darken-3;
    color: $text;
    padding: 0 2;
    text-style: bold;
}

/* Chat Pane and messaging layout */
ChatPane {
    height: 1fr;
    padding: 1;
}

ChatArea {
    height: 1fr;
    padding: 1;
    border: round $primary-darken-2;
    background: $surface-darken-1;
}

#chat-input-box {
    margin-top: 1;
    height: auto;
}

#chat-mode-label {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
    padding-left: 1;
}

/* User Message Widget */
UserMessageWidget {
    background: $surface-darken-2;
    border-left: thick $accent;
    padding: 1 2;
    margin-bottom: 2;
    margin-left: 4;
    height: auto;
}

.user-label {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

/* Assistant Message Widget */
AssistantMessageWidget {
    background: $surface-darken-1;
    border-left: thick $primary;
    padding: 1 2;
    margin-bottom: 2;
    margin-right: 4;
    height: auto;
}

.assistant-header {
    layout: horizontal;
    align: left middle;
    margin-bottom: 1;
    height: 2;
}

.assistant-label {
    color: $primary;
    text-style: bold;
    width: 1fr;
}

.copy-btn {
    min-width: 8;
    height: 1;
    border: none;
    background: $primary-darken-2;
    color: $text;
    margin-right: 2;
    text-style: bold;
}

.copy-btn:hover {
    background: $primary-darken-1;
}

/* Modal Screens */
OnboardingScreen, SettingsScreen, CommandPalette {
    align: center middle;
    background: rgba(0, 0, 0, 0.6);
}

#onboarding-container, #settings-container, #palette-container {
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#onboarding-container {
    width: 70;
    height: auto;
}

#settings-container {
    width: 60;
    height: auto;
}

#palette-container {
    width: 60;
    max-height: 24;
}

#onboarding-title, #settings-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
}

#onboarding-grid, #settings-grid {
    grid-size: 2;
    grid-columns: 1fr 2fr;
    grid-gutter: 1;
    margin-bottom: 2;
}

#onboarding-grid Label, #settings-grid Label {
    padding-top: 1;
    color: $text-muted;
}

#onboarding-status {
    color: $accent;
    margin-bottom: 1;
    text-align: center;
    text-style: bold;
}

#model-selection-box {
    height: 8;
    border: round $primary-darken-2;
    background: $surface-darken-1;
    margin-bottom: 2;
}

/* Button & Dialog layout */
#buttons-row {
    align: right middle;
}

#buttons-row Button {
    margin-left: 1;
}

/* Command Palette Inner Styling */
CommandPalette {
    align: center top;
    padding-top: 4;
}

#palette-input {
    border: none;
    margin: 0;
    background: $surface-darken-1;
}

.palette-item {
    padding: 0 1;
}

.palette-name {
    color: $accent;
    text-style: bold;
}

.palette-desc {
    color: $text-muted;
    margin-left: 2;
}

/* Ingestion / Analysis Pipeline View */
#analysis-view {
    align: center middle;
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 0 4;
}

#analysis-title {
    color: $text;
    text-style: bold;
    margin-bottom: 2;
    text-align: center;
}

#analysis-repo-name {
    color: $text-muted;
    margin-bottom: 1;
    text-align: center;
}

#analysis-progress-bar {
    width: 60;
    margin-bottom: 2;
}

#analysis-pipeline-stages {
    width: 40;
    margin-bottom: 2;
    align: center middle;
}

.stage-item {
    margin-bottom: 1;
    text-align: left;
}

.stage-item.pending {
    color: $text-muted;
}

.stage-item.running {
    color: $accent;
    text-style: bold;
}

.stage-item.complete {
    color: $success;
    text-style: bold;
}

#analysis-current-task {
    color: $text-muted;
    text-align: center;
    margin-top: 1;
}

#settings-status {
    color: $error;
    text-align: center;
    margin-top: 1;
    margin-bottom: 1;
}
